uint8_t GPIO_read_pin(GPIO_t *GPIO_port, uint8_t pin_number) {
  uint16_t temp = GPIO_port->IDR >> pin_number; // 16 bits accessible in IDR;
  return (uint8_t)(temp & 0x1U);
}

